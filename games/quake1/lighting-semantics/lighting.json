  "undeclared_traits": [
    {
      "trait": "colour",
      "reason": "Quake 1 as id shipped it has no per-light colour key. A profile that declares one supplies the key name; until it does, colour is unknown rather than white."
    },
    {
      "trait": "surface_intent",
      "reason": "Quake 1 has no surface-light mechanism in the shipped vocabulary. A light entity is a point sample. A profile that declares a surface-emission mechanism supplies it; inferring one from geometry would be an invented semantic."
    }
